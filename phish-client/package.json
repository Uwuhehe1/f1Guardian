{
  "name": "phish-client",
  "version": "1.0.0",
  "description": "Desktop client for phishing detection system",
  "main": "app.js",
  "author": "Your Org",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.yourorg.phishclient",
    "productName": "Phish Client",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "files": [
      "app.js",
      "assets/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "publisherName": "Your Organization"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Phish Client"
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ]
    }
  }
}
